            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Phone</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Mobile_Phone</name>
        <label>Set Mobile Phone</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.MobilePhone</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Phone</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Other_Phone</name>
        <label>Set Other Phone</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.OtherPhone</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Phone</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Phone_to_Preferred_Phone_value</name>
        <label>Set Phone to Preferred Phone value</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Phone</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>formulaPreferredPhoneNumber</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Work_Phone</name>
        <label>Set Work Phone</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.npe01__WorkPhone__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Phone</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Phone_Update_Needed</name>
        <label>Phone Update Needed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>NPSP_Phone_field_changed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.npe01__PreferredPhone__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.HomePhone</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.MobilePhone</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OtherPhone</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.npe01__WorkPhone__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Phone</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Phone_to_Preferred_Phone_value</targetReference>
            </connector>
            <label>NPSP Phone field changed</label>
        </rules>
        <rules>
            <name>Phone_Changed_or_Newly_Set</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Phone</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Phone</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record__Prior.Phone</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Preferred_Phone</targetReference>
            </connector>
            <label>Phone Changed or Newly Set</label>
        </rules>
        <rules>
            <name>NPSP_Phone_fields_not_set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.npe01__PreferredPhone__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.HomePhone</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.MobilePhone</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OtherPhone</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.npe01__WorkPhone__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Phone</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Default_Preferred_Phone</targetReference>
            </connector>
            <label>NPSP Phone fields not set</label>
        </rules>
    </decisions>
    <decisions>
        <name>Preferred_Phone</name>
        <label>Preferred Phone</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Home</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.npe01__PreferredPhone__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Home</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Home_Phone</targetReference>
            </connector>
            <label>Home</label>
        </rules>
        <rules>
            <name>Mobile</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.npe01__PreferredPhone__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Mobile</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Mobile_Phone</targetReference>
            </connector>
            <label>Mobile</label>
        </rules>
        <rules>
            <name>Work</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.npe01__PreferredPhone__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Work</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Work_Phone</targetReference>
            </connector>
            <label>Work</label>
        </rules>
        <rules>
            <name>Other</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.npe01__PreferredPhone__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Other</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Other_Phone</targetReference>
            </connector>
            <label>Other</label>
        </rules>
    </decisions>
    <description>This flow consists of a single main decision element, which checks to see which preferred phone option is selected. For each value, if the associated field is not null, then its value is copied to the main phone field.
This flow replaces workflows which do the same thing and have been deactivated.</description>
    <environments>Default</environments>
    <formulas>
        <description>Returns the Home Phone number if it&apos;s populated. If not, checks and returns Mobile, Work, and Other if populated, in that order. If all are blank, defaults to the value of the standard Phone field.</description>
        <name>formulaHomePhoneNumber</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.HomePhone})), {!$Record.HomePhone},
IF(NOT(ISBLANK({!$Record.MobilePhone})), {!$Record.MobilePhone},
IF(NOT(ISBLANK({!$Record.npe01__WorkPhone__c})), {!$Record.npe01__WorkPhone__c},
IF(NOT(ISBLANK({!$Record.OtherPhone})), {!$Record.OtherPhone},
{!$Record.Phone}))))</expression>
    </formulas>
    <formulas>
        <description>Returns the Mobile Phone number if it&apos;s populated. If not, checks and returns Home, Work, and Other if populated, in that order. If all are blank, defaults to the value of the standard Phone field.</description>
        <name>formulaMobilePhoneNumber</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.MobilePhone})), {!$Record.MobilePhone},
IF(NOT(ISBLANK({!$Record.HomePhone})), {!$Record.HomePhone},
IF(NOT(ISBLANK({!$Record.npe01__WorkPhone__c})), {!$Record.npe01__WorkPhone__c},
IF(NOT(ISBLANK({!$Record.OtherPhone})), {!$Record.OtherPhone},
{!$Record.Phone}))))</expression>
    </formulas>
    <formulas>
        <description>Returns the Other Phone number if it&apos;s populated. If not, checks and returns Mobile, Work, and Home if populated, in that order. If all are blank, defaults to the value of the standard Phone field.</description>
        <name>formulaOtherPhoneNumber</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.OtherPhone})), {!$Record.OtherPhone},
IF(NOT(ISBLANK({!$Record.MobilePhone})), {!$Record.MobilePhone},
IF(NOT(ISBLANK({!$Record.npe01__WorkPhone__c})), {!$Record.npe01__WorkPhone__c},
IF(NOT(ISBLANK({!$Record.HomePhone})), {!$Record.HomePhone},
{!$Record.Phone}))))</expression>
    </formulas>
    <formulas>
        <description>Returns the value of the Contact&apos;s preferred phone number. Defaults to Work Phone if no preferred number selected.</description>
        <name>formulaPreferredPhoneNumber</name>
        <dataType>String</dataType>
        <expression>CASE({!$Record.npe01__PreferredPhone__c},
&apos;Home&apos;, {!formulaHomePhoneNumber},
&apos;Mobile&apos;, {!formulaMobilePhoneNumber},
&apos;Work&apos;, {!formulaWorkPhoneNumber},
&apos;Other&apos;, {!formulaOtherPhoneNumber},
{!formulaWorkPhoneNumber}
)</expression>
    </formulas>
    <formulas>
        <description>Returns the Work Phone number if it&apos;s populated. If not, checks and returns Mobile, Home, and Other if populated, in that order. If all are blank, defaults to the value of the standard Phone field.</description>
        <name>formulaWorkPhoneNumber</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!$Record.npe01__WorkPhone__c})), {!$Record.npe01__WorkPhone__c},
IF(NOT(ISBLANK({!$Record.MobilePhone})), {!$Record.MobilePhone},
IF(NOT(ISBLANK({!$Record.HomePhone})), {!$Record.HomePhone},
IF(NOT(ISBLANK({!$Record.OtherPhone})), {!$Record.OtherPhone},
{!$Record.Phone}))))</expression>
    </formulas>
    <interviewLabel>@CONTACT || C/U | Update Phone Based on Preferred Phone {!$Flow.CurrentDateTime}</interviewLabel>
    <label>@CONTACT || C/U | Update Phone Based on Preferred Phone</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Phone_Update_Needed</targetReference>
        </connector>
        <filterFormula>OR(
       ISCHANGED({!$Record.npe01__PreferredPhone__c}),
       ISCHANGED({!$Record.HomePhone}),
       ISCHANGED({!$Record.MobilePhone}),
       ISCHANGED({!$Record.npe01__WorkPhone__c}),
       ISCHANGED({!$Record.OtherPhone}),
       ISNEW(),
       ISCHANGED({!$Record.Phone})
)</filterFormula>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
