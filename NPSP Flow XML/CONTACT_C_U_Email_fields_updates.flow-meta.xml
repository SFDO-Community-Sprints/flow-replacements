    <decisions>
        <name>Email_Update_Needed</name>
        <label>Email Update Needed</label>
        <locationX>986</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Standard_Email_is_New_or_Changed</name>
            <conditionLogic>(1 OR 3) AND 2 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Email</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Email</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Email</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.npe01__Preferred_Email__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Preferred_Email</targetReference>
            </connector>
            <label>Standard Email is New or Changed</label>
        </rules>
        <rules>
            <name>NPSP_Email_fields_are_changed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.npe01__AlternateEmail__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.npe01__HomeEmail__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.npe01__WorkEmail__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Email</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.npe01__Preferred_Email__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_new_Email_value</targetReference>
            </connector>
            <label>NPSP Email fields are changed</label>
        </rules>
        <rules>
            <name>No_Preferred_Email_set</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.npe01__Preferred_Email__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.npe01__AlternateEmail__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.npe01__HomeEmail__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.npe01__WorkEmail__c</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Email</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Preferred_Email_to_Work</targetReference>
            </connector>
            <label>No Preferred Email set</label>
        </rules>
    </decisions>
    <decisions>
        <name>Preferred_Email</name>
        <label>Preferred Email</label>
        <locationX>446</locationX>
        <locationY>395</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Alternate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.npe01__Preferred_Email__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Alternate</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Alternate_Email</targetReference>
            </connector>
            <label>Alternate</label>
        </rules>
        <rules>
            <name>Personal</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.npe01__Preferred_Email__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Personal</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Personal_Email</targetReference>
            </connector>
            <label>Personal</label>
        </rules>
        <rules>
            <name>Work</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.npe01__Preferred_Email__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Work</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Work_Email</targetReference>
            </connector>
            <label>Work</label>
        </rules>
    </decisions>
    <description>Runs when email fields on the contact are changed. Populates the Email field with the contact&apos;s preferred email address and keeps it synced when it changes.</description>
    <environments>Default</environments>
    <formulas>
        <description>Value of Email field when Preferred Email Type = &apos;Alternate&apos;</description>
        <name>AlternateEmail</name>
        <dataType>String</dataType>
        <expression>if(len({!$Record.npe01__AlternateEmail__c})&gt;0, {!$Record.npe01__AlternateEmail__c},
if(len({!$Record.npe01__WorkEmail__c})&gt;0, {!$Record.npe01__WorkEmail__c},
{!$Record.npe01__HomeEmail__c))}</expression>
    </formulas>
    <formulas>
        <description>Returns true if at least one NPSP email field is populated.</description>
        <name>formulaNPSPEmailPresent</name>
        <dataType>Boolean</dataType>
        <expression>OR(
NOT(ISBLANK({!$Record.npe01__AlternateEmail__c})),
NOT(ISBLANK({!$Record.npe01__HomeEmail__c})),
NOT(ISBLANK({!$Record.npe01__WorkEmail__c}))
)</expression>
    </formulas>
    <formulas>
        <description>Returns the value of whichever email address is set as Preferred. If no NPSP email addresses are populated returns the value of the standard Email field.</description>
        <name>formulaPreferredEmailAddress</name>
        <dataType>String</dataType>
        <expression>IF({!formulaNPSPEmailPresent}, (CASE({!$Record.npe01__Preferred_Email__c}, 
    &apos;Alternate&apos;, {!AlternateEmail}, 
    &apos;Personal&apos;, {!PersonalEmail},
    &apos;Work&apos;, {!WorkEmail},
    {!PersonalEmail})), 
   {!$Record.Email}
)</expression>
    </formulas>
    <formulas>
        <description>Value of Email field based on Preferred Email Type = Personal</description>
        <name>PersonalEmail</name>
        <dataType>String</dataType>
        <expression>if(len({!$Record.npe01__HomeEmail__c)}&gt;0, {!$Record.npe01__HomeEmail__c},
if(len({!$Record.npe01__WorkEmail__c)}&gt;0, {!$Record.npe01__WorkEmail__c},
{!$Record.npe01__AlternateEmail__c}))</expression>
    </formulas>
    <formulas>
        <name>WorkEmail</name>
        <dataType>String</dataType>
        <expression>if(len({!$Record.npe01__WorkEmail__c})&gt;0, {!$Record.npe01__WorkEmail__c},
if(len({!$Record.npe01__HomeEmail__c})&gt;0, {!$Record.npe01__HomeEmail__c},
{!$Record.npe01__AlternateEmail__c}))</expression>
    </formulas>
    <interviewLabel>@CONTACT || C/U | Email fields updates {!$Flow.CurrentDateTime}</interviewLabel>
    <label>@CONTACT || C/U | Email fields updates</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>860</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Email_Update_Needed</targetReference>
        </connector>
        <filterFormula>OR(
ISCHANGED({!$Record.Email}),
ISBLANK({!$Record.Email}),
ISCHANGED({!$Record.npe01__Preferred_Email__c}),
ISCHANGED({!$Record.npe01__AlternateEmail__c}),
ISCHANGED({!$Record.npe01__HomeEmail__c}),
ISCHANGED({!$Record.npe01__WorkEmail__c}),
AND(ISNULL({!$Record__Prior.Email}), NOT(ISNULL({!$Record.Email})))
)</filterFormula>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
